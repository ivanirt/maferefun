generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  category    String
  orisha      String
  description String
  priceMxn    Int
  imagePath   String
  createdAt   DateTime    @default(now())
  orderItems  OrderItem[]
}

model Devotee {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  whatsapp     String?
  createdAt    DateTime   @default(now())
  orders       Order[]
  consultas    Consulta[]
}

model Order {
  id          String      @id @default(cuid())
  code        String      @unique
  devoteeId   String?
  devotee     Devotee?    @relation(fields: [devoteeId], references: [id])
  email       String
  name        String
  whatsapp    String
  address     String
  notes       String?
  subtotal    Int
  shipping    Int
  consecration Int        @default(0)
  total       Int
  status      String      @default("pendiente_pago")
  paymentId   String?
  createdAt   DateTime    @default(now())
  items       OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Int
}

model Consulta {
  id        String   @id @default(cuid())
  devoteeId String?
  devotee   Devotee? @relation(fields: [devoteeId], references: [id])
  name      String
  email     String
  whatsapp  String
  kind      String
  message   String?
  status    String   @default("solicitada")
  createdAt DateTime @default(now())
}
