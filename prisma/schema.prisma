generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String         @id @default(cuid())
  slug        String         @unique
  name        String
  category    String
  orisha      String
  description String
  priceMxn    Int
  stock       Int            @default(0)
  minStock    Int            @default(1)
  enabled     Boolean        @default(true)
  inCarousel  Boolean        @default(false)
  detail      String         @default("")
  imagePath   String
  createdAt   DateTime       @default(now())
  images      ProductImage[]
  offers      Offer[]
  orderItems  OrderItem[]
  packageItems PackageItem[]
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  path      String
  sort      Int     @default(0)
}

model Offer {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceMxn  Int
  startsAt  DateTime
  endsAt    DateTime
}

model Package {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String
  enabled     Boolean       @default(true)
  createdAt   DateTime      @default(now())
  items       PackageItem[]
  orderItems  OrderItem[]
}

model PackageItem {
  id        String   @id @default(cuid())
  packageId String
  package   Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Int
}

model Devotee {
  id           String     @id @default(cuid())
  username     String     @unique
  email        String     @unique
  passwordHash String
  name         String
  role         String     @default("user")
  wantsNews    Boolean    @default(true)
  whatsapp     String?
  createdAt    DateTime   @default(now())
  orders         Order[]
  consultas      Consulta[]
  addresses      Address[]
  paymentMethods PaymentMethod[]
}

model Address {
  id        String  @id @default(cuid())
  devoteeId String
  devotee   Devotee @relation(fields: [devoteeId], references: [id], onDelete: Cascade)
  label     String
  line1     String
  city      String
  state     String
  zip       String
  phone     String
  isDefault Boolean @default(false)
}

model PaymentMethod {
  id        String  @id @default(cuid())
  devoteeId String
  devotee   Devotee @relation(fields: [devoteeId], references: [id], onDelete: Cascade)
  label     String
  brand     String
  last4     String
  expMonth  Int
  expYear   Int
  holder    String
  isDefault Boolean @default(false)
}

model Post {
  id        String   @id @default(cuid())
  slug      String   @unique
  kind      String
  title     String
  body      String
  published Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Order {
  id           String      @id @default(cuid())
  code         String      @unique
  devoteeId    String?
  devotee      Devotee?    @relation(fields: [devoteeId], references: [id])
  email        String
  name         String
  whatsapp     String
  address      String
  notes        String?
  subtotal     Int
  shipping     Int
  consecration Int         @default(0)
  total        Int
  status       String      @default("pendiente_pago")
  paymentId    String?
  createdAt    DateTime    @default(now())
  items        OrderItem[]
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  packageId String?
  package   Package? @relation(fields: [packageId], references: [id])
  quantity  Int
  unitPrice Int
}

model Consulta {
  id          String   @id @default(cuid())
  devoteeId   String?
  devotee     Devotee? @relation(fields: [devoteeId], references: [id])
  name        String
  email       String
  whatsapp    String
  kind        String
  modality    String?
  scheduledAt DateTime?
  message     String?
  status      String   @default("solicitada")
  createdAt   DateTime @default(now())

  @@index([scheduledAt])
}

model ConsultaSlot {
  id          String  @id @default(cuid())
  weekday     Int
  startTime   String
  durationMin Int     @default(60)
  modality    String  @default("ambas")
  enabled     Boolean @default(true)

  @@unique([weekday, startTime])
}
